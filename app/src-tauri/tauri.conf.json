{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "W.A.R.P.",
  "version": "0.1.0",
  "identifier": "com.stigsmith.warp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "W.A.R.P.",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0a0c09"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
