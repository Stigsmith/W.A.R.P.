#!/bin/sh
# Local checks before every commit: formatting, lints, tests, UI types.
# Enable once per clone:  git config core.hooksPath .githooks
set -e
export PATH="$HOME/.cargo/bin:$PATH"

echo "pre-commit: cargo fmt"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy"
cargo clippy --workspace --all-targets --quiet -- -D warnings

echo "pre-commit: cargo test"
cargo test --workspace --quiet

echo "pre-commit: svelte-check"
(cd app && npx --no-install svelte-check --tsconfig ./tsconfig.json --threshold error --output human)

echo "pre-commit: changelog"
app_version=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' app/src-tauri/tauri.conf.json | head -1)
log_version=$(sed -n 's/^ *version: "\(.*\)",$/\1/p' app/src/lib/changelog.ts | head -1)
if [ "$app_version" != "$log_version" ]; then
  echo "The app is $app_version but app/src/lib/changelog.ts starts at $log_version: add this version's changes."
  exit 1
fi
